# Springtale Tauri frontend npm/pnpm policy.
# Mirrors root .npmrc with the same Shai-Hulud / Axios mitigations.

ignore-scripts=true
registry=https://registry.npmjs.org/
audit-level=moderate
frozen-lockfile=true
strict-peer-dependencies=true

# pnpm lockfile schema version — pin so a contributor's older pnpm doesn't
# silently downgrade the lockfile format.
lockfile-version=9

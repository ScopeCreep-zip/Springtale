# ── Rust Build ─────────────────────────────────────────────────────
/target/
**/target/
**/*.rs.bk
*.pdb

# ── IDE ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
*.iml

# ── OS ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
._*

# ── Claude Code (local-only, not shared) ──────────────────────────
.claude/settings.local.json
.claude/keybindings.json

# ── Secrets (never commit — vault, env, keys) ─────────────────────
.env
.env.*
**/vault.bin
**/secrets/
*.pem
*.key
*.p12
cosign.key

# ── Node / TypeScript SDK ─────────────────────────────────────────
node_modules/
**/dist/
sdk/**/*.tsbuildinfo
.pnpm-store/

# springtaled embeds the dashboard SPA via rust-embed (`src/api/dashboard.rs`),
# whose derive macro requires the folder to exist at compile time. Keep a
# tracked sentinel so `cargo build`/`clippy`/`test` compile without a prior
# frontend build; the real `vite build` output (index.html + hashed assets)
# stays ignored and overrides the placeholder at runtime.
!tauri/apps/dashboard/dist/
tauri/apps/dashboard/dist/*
!tauri/apps/dashboard/dist/.gitkeep

# ── Tauri generated schemas ───────────────────────────────────────
**/src-tauri/gen/

# ── Nix ────────────────────────────────────────────────────────────
result
result-*
.direnv/

# ── Springtale Runtime (user-specific, not committed) ─────────────
springtale.toml
data/
*.sock

# ── Docker ─────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Database (local dev) ──────────────────────────────────────────
*.db
*.db-shm
*.db-wal
# Don't ignore migrations — those are committed
!**/migrations/**

# ── WASM build artifacts ──────────────────────────────────────────
*.wasm
!sdk/**/*.wasm

# ── CI artifacts (generated, not committed) ───────────────────────
sbom.cdx.json
container-sbom.cdx.json
*.sarif

# ── Coverage / profiling ──────────────────────────────────────────
*.profraw
*.profdata
lcov.info
coverage/
tarpaulin-report.html

# ── Fuzzing corpus (can be large) ─────────────────────────────────
fuzz/corpus/
fuzz/artifacts/

# ── Backup files from travel mode ─────────────────────────────────
*.enc

# ── Font sources (multi-megabyte upstream TTFs; only the subset ships) ──
vendor/fonts/*.ttf
vendor/fonts/*.zip

# Tauri sidecar staging — `springtaled-{target-triple}` is produced by the
# packaging step (cargo build -p springtaled, then copy + rename). Never
# commit a binary.
tauri/apps/desktop/src-tauri/binaries/

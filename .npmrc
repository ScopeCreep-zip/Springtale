# Springtale npm/pnpm policy — root.
# Per CISA Sep-2025 npm Shai-Hulud advisory and Apr-2026 Axios advisory.
# https://www.cisa.gov/news-events/alerts/2025/09/23/widespread-supply-chain-compromise-impacting-npm-ecosystem

# Block ALL package lifecycle scripts (pre/post-install, prepare, etc.).
# Required to neutralise the Shai-Hulud + similar self-replicating worms.
ignore-scripts=true

# Pin the registry explicitly to prevent dependency-confusion via
# misconfigured proxies.
registry=https://registry.npmjs.org/

# Refuse to install anything below `moderate` severity for known advisories.
audit-level=moderate

# Lockfile required; fail if missing or out of sync.
frozen-lockfile=true

# Tell pnpm to refuse builds if peer deps are missing.
strict-peer-dependencies=true
